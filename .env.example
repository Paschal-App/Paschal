# Copy this file to .env and adjust. At minimum, set POSTGRES_PASSWORD.

# --- Database --------------------------------------------------------
POSTGRES_USER=paschal
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=paschal

# --- Public URL ------------------------------------------------------
# The address people reach this instance at. Used in the links emailed to
# recipients, so it must be the real external URL once you go live
# (for example https://vault.example.com).
BEACON_PUBLIC_BASE_URL=http://localhost:8080

# --- Passkeys / WebAuthn ---------------------------------------------
# Passkey sign-in is cryptographically bound to your domain. RP_ID is the
# registrable domain (no scheme or port); RP_ORIGIN is the full origin(s) the
# app is served from, comma-separated (the first is primary). These MUST match
# the URL in the user's browser or passkeys silently fail. WebAuthn only works
# over localhost or HTTPS.
#   Local dev (API on :8080, Vite dev server on :5173):
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080,http://localhost:5173
#   Production example:
#   WEBAUTHN_RP_ID=vault.example.com
#   WEBAUTHN_RP_ORIGIN=https://vault.example.com

# --- Email delivery --------------------------------------------------
# How the Beacon sends release notices, buddy invites, and recovery codes.
#   stub   (default) — write to STUB_NOTIFICATIONS_LOG, send nothing (dev)
#   resend — the Resend hosted email API (set RESEND_API_KEY)
#   smtp   — any SMTP server you run or have submission credentials for
NOTIFICATIONS_BACKEND=stub
# Envelope From for all outbound mail. Use an address on a domain you control.
EMAIL_FROM=Paschal <noreply@localhost>
STUB_NOTIFICATIONS_LOG=./logs/notifications.log
#
# Resend (NOTIFICATIONS_BACKEND=resend) — set a real key in your .env, not here.
RESEND_API_KEY=
#
# Self-hosted SMTP (NOTIFICATIONS_BACKEND=smtp). SMTP_TLS: starttls (587),
# implicit (465), or none (25, trusted local relay). Leave username/password
# empty for an unauthenticated relay; set the password in your real .env only.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Switch behaviour ------------------------------------------------
# Cooling-off window before letters release, in seconds (default 14 days).
COOLING_OFF_SECONDS=1209600
# Max gap between check-ins before the switch begins to trip (7 days).
HEARTBEAT_MAX_GAP_SECONDS=604800
# How often the signal aggregator re-evaluates vaults (5 minutes).
AGGREGATOR_TICK_SECONDS=300

# --- Account defaults ------------------------------------------------
TRIAL_DAYS=30
# How long data is retained after cancellation, in days (3 years).
RETENTION_DAYS=1095
MAX_UPLOAD_BYTES=16777216
RATE_LIMIT_PER_MINUTE=240
